# Copy this file to .env and set your values (.env is git-ignored)
SECRET_KEY=change-this-to-a-long-random-secret-key

# Port to listen on (on macOS, 5000 is often used by AirPlay Receiver; try 5001)
PORT=5000

# Debug mode: keep 0 (off) unless you are developing locally. Never enable on a real server.
FLASK_DEBUG=0

# Allowed WebSocket origins (comma-separated). Defaults to the local dev URLs.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Set to 1 in production behind Nginx/Caddy to enable X-Forwarded-For
TRUST_PROXY=0

# Optional: Get a free key at https://www.abuseipdb.com/register
# Without this key the Threat Intelligence panel returns mock data (UI still works)
ABUSEIPDB_API_KEY=your_free_key_from_abuseipdb.com
